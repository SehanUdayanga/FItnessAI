PORT=5000
# Local MongoDB (recommended for local development)
MONGO_URI=mongodb://127.0.0.1:27017/fittrack
# Or MongoDB Atlas Cloud:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fittrack?retryWrites=true&w=majority

JWT_SECRET=your_super_secret_jwt_key_change_me

# Google Gemini API Key for AI Food Scanner & AI Assistant
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash
